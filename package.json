{
  "name": "dsh-macro-memory",
  "version": "0.2.92",
  "private": false,
  "description": "宏观记忆调控插件：以 meow-memory 的记忆库为主库、dsh-memory-nebula 的星图为索引，融合成一套 8 个 memory_* 统一工具 + 一段最小注入；两个原插件退化为引擎，工具面与注入面由本插件统一接管并互相联动。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node build.mjs",
    "verify": "node verify.mjs",
    "probe": "node tools/probe-fusion.mjs"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "macro",
    "meow-memory",
    "memory-nebula",
    "fusion",
    "unified-tools"
  ]
}
