{
  "name": "dsh-macro-memory",
  "version": "0.8.1",
  "private": false,
  "description": "宏观记忆调控：以 meow-memory 的记忆库为主库、dsh-memory-nebula 的星图为索引，融合成一套 8 个 memory_* 统一工具 + 一段最小注入。0.8.1 起同一份库可直接给 Codex / Claude Code / Cursor 等任意 MCP agent 用——装 DSH 是体验最好的路，但不再是唯一的路。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanhan9999999999999999999/dsh-macro-memory.git"
  },
  "homepage": "https://github.com/hanhan9999999999999999999/dsh-macro-memory#readme",
  "bugs": {
    "url": "https://github.com/hanhan9999999999999999999/dsh-macro-memory/issues"
  },
  "main": "lib/index.js",
  "bin": {
    "macro-memory": "./bin/macro-memory.mjs",
    "dsh-macro-memory": "./bin/macro-memory.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core/index.js",
    "./mcp": "./lib/mcp/server.js",
    "./cli": "./bin/macro-memory.mjs",
    "./ui": "./lib/ui/server.js",
    "./client": "./lib/client.js",
    "./dsh": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "vendor",
    "docs/images",
    "docs/MAC.md",
    "docs/CHANGELOG.md",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build:client": "node build.mjs",
    "verify": "node verify.mjs",
    "probe": "node tools/probe-fusion.mjs",
    "dual": "node tools/build-dual.mjs",
    "pack:dual": "node tools/build-dual.mjs --apply --pack",
    "probe:core": "node tools/probe-core.mjs",
    "mcp": "node bin/macro-memory.mjs mcp",
    "doctor": "node bin/macro-memory.mjs doctor"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "macro",
    "meow-memory",
    "memory-nebula",
    "fusion",
    "unified-tools",
    "mcp",
    "model-context-protocol",
    "agent-memory",
    "codex",
    "claude-code",
    "universal"
  ]
}
